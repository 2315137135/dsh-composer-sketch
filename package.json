{
  "name": "@local/dsh-composer-sketch",
  "version": "0.1.0",
  "private": true,
  "description": "An Excalidraw whiteboard as a right-sidebar tab, attaching the layout as an image to the composer.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "client.whiteboard.js",
    "cordis.patch.yml",
    "locale/*.json",
    "assets/**",
    "icon.svg",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
